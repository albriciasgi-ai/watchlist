# Bybit API Credentials
# IMPORTANT: Never commit the actual .env file to version control!

# Get your API keys from: https://testnet.bybit.com/app/user/api-management (Testnet)
# Or: https://www.bybit.com/app/user/api-management (Live)

BYBIT_API_KEY=your_api_key_here
BYBIT_API_SECRET=your_api_secret_here

# Use testnet for testing, set to false for live trading
BYBIT_TESTNET=true

# Server Configuration
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Logging Level (INFO, WARNING, ERROR)
LOG_LEVEL=INFO
